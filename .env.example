# Copy to .env and fill in your Tenable.io API keys.
# Names and defaults must stay in sync with config.py.

# ── Tenable API ──────────────────────────────────────────────────────────────
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_BASE_URL=https://cloud.tenable.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=7200

# ── Cache (seconds) ──────────────────────────────────────────────────────────
CACHE_TTL_SEC=7200

# ── Asset export ─────────────────────────────────────────────────────────────
INCLUDE_OPEN_PORTS=true

# ── Vulnerability sync / export ──────────────────────────────────────────────
VULN_EXPORT_NUM_ASSETS=500
VULN_EXPORT_INCLUDE_UNLICENSED=true
VULN_SYNC_POLL_INTERVAL_SEC=60
VULN_SYNC_POLL_MAX_ATTEMPTS=20
VULN_FULL_SYNC_SINCE=0
VULN_EXPORT_SEVERITY_MODIFICATION_TYPES=NONE,RECASTED,ACCEPTED

# ── Storage (optional; defaults are project-relative paths) ──────────────────
# VULN_DB_PATH=vulnerabilities.db
# VULN_RAW_JSON_DIR=data/vuln_raw

# ── HTTP / download ──────────────────────────────────────────────────────────
CHUNK_DOWNLOAD_TIMEOUT_SEC=600
CHUNK_DOWNLOAD_DELAY_SEC=1
API_RETRY_MAX_ATTEMPTS=5
API_RETRY_BACKOFF_SEC=2
